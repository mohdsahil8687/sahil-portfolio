# Supabase Dashboard > Project Settings > Data API / API Keys
# Copy the public project URL and the "anon" (publishable) key only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: set to "true" only after enabling Google OAuth in Supabase dashboard
VITE_GOOGLE_AUTH_ENABLED=false

# Google OAuth Client ID and Client Secret belong in Supabase Auth > Google.
# Never add a Google Client Secret, service-role key, or management token here.
# App redirects use the current origin + /admin or /community. See docs/ADMIN_SETUP.md.

# Never put the service_role/secret key in a VITE_ variable.
